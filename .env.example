# 复制为 .env 后按实际改。注意：BASE_URL 会写进二维码，改域名必须重新生成码。
PORT=3000

# 公网可访问地址（手机扫码打开的地址），不要写 localhost
# 直接用 IP 演示：http://1.2.3.4:3000
# 走 Nginx + 域名：https://demo.example.com
BASE_URL=http://127.0.0.1:3000

# 生产环境
NODE_ENV=production

# 可选：数据库路径（默认 data/app.db）
# DB_PATH=/opt/qr-system/data/app.db

# 可选：受限环境（不能删除 WAL 文件）时用 TRUNCATE
# SQLITE_JOURNAL=WAL
